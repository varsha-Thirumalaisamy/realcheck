# REALCHECK AI - Environment Variables Configuration Template
# Copy this file to .env and adjust variables as needed

# Application Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Frontend Configuration
VITE_API_URL=http://localhost:8000/api
VITE_APP_TITLE=REALCHECK AI

# Security & Secrets (Do NOT commit real keys)
SECRET_KEY=change-this-in-production
API_KEY=
DATABASE_URL=postgresql://postgres:password@localhost:5432/realcheck

# Detector Engine Settings
ENABLE_DEMO_MODE=true
MAX_UPLOAD_SIZE_MB=50
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
